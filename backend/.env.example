# The app works without any key (basic mode: rule-based explanations, plus keyword-based retrieval).
# Add a key to get AI explanations and AI answers to follow-up questions.

# OpenAI:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# With an OpenAI key (no LLM_BASE_URL below), the RAG feature also switches from keyword search to
# real OpenAI embeddings (text-embedding-3-small) for better matching.

# Groq (OpenAI-compatible, chat only — Groq does not serve embeddings, so RAG stays keyword-based):
# LLM_API_KEY=gsk_...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant

# Websites allowed to call this API (comma separated). Add your Netlify URL after deploying.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Requests allowed per minute for each visitor
RATE_LIMIT_PER_MIN=15
